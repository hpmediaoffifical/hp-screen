{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "snip-extras",
  "description": "Pinned pictures and the scrolling-capture bar and frame (capture and annotate)",
  "windows": ["pin-*", "scroll-bar", "scroll-frame"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
