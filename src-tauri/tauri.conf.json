{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HP Screen",
  "version": "0.1.0",
  "identifier": "vn.hpscreen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HP Screen",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "control-bar",
        "title": "HP Screen - Điều khiển",
        "url": "index.html",
        "width": 330,
        "height": 52,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
