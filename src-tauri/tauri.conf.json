{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HP Screen",
  "version": "0.2.1",
  "identifier": "vn.hpscreen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HP Screen",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "control-bar",
        "title": "HP Screen - Điều khiển",
        "url": "index.html",
        "width": 620,
        "height": 56,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "publisher": "HP Media",
    "copyright": "© 2026 HP Media — Nguyễn Hoàng Phụng",
    "homepage": "https://github.com/hpmediaoffifical/hp-screen",
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RDE0RUQ3OTg0NDBGNDYKUldSR0QwU1kxMDdSNTdEOWE4ZzQ0VnZlZk55b000VFl6R3JvdGlWNmp5Tm1PS0dBc0FmdGdjK0wK",
      "endpoints": ["https://github.com/hpmediaoffifical/hp-screen/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
