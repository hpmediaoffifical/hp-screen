{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HP Screen",
  "version": "0.2.5",
  "identifier": "vn.hpscreen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HP Screen",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "control-bar",
        "title": "HP Screen - Điều khiển",
        "url": "index.html",
        "width": 620,
        "height": 56,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "publisher": "HP Media",
    "copyright": "© 2026 HP Media — Nguyễn Hoàng Phụng",
    "homepage": "https://github.com/hpmediaoffifical/hp-screen",
    "active": true,
    "targets": ["nsis"],
    "resources": ["third-party/README.md", "third-party/licenses/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQ0YzNUU3NjU3QUIxNUQKUldSZHNYcGw1elhQRzRoeXppQVk4bVBWR0h5cnZKT1lSRzhkSGcrZjQwaHBmcVB2bHJSMGtmTFAK",
      "endpoints": ["https://github.com/hpmediaoffifical/hp-screen/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
